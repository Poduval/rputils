import pandas as pd
import seaborn as sns


class ExploreData():
    
    pi = 3.14
    
    def __init__(self, data=pd.DataFrame()):
        self.data = data
        
    def summary(self, arg=str):
        summary = self.data.describe()
        print(arg)
        return summary
    
    def plot(self):
        fig = sns.pairplot(self.data)
        return fig


